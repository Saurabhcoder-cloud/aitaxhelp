# ==============================================================================
# TaxAIHelp Environment Variables Example
# Domain: taxaihelp.com
# DO NOT COMMIT SENSITIVE KEYS TO VERSION CONTROL
# ==============================================================================

# Application URL
NEXT_PUBLIC_SITE_URL=https://taxaihelp.com

# Supabase (Client-safe public config)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Gemini AI (Server-only secret: NEVER expose with NEXT_PUBLIC prefix)
GEMINI_API_KEY=your-server-side-gemini-api-key

# Server-side Runtime Environment (development | staging | production)
NODE_ENV=development
