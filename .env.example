# ==============================================================================
# TaxAIHelp Environment Variables Example
# Domain: taxaihelp.com
# DO NOT COMMIT SENSITIVE OR PRODUCTION CREDENTIALS TO VERSION CONTROL
# ==============================================================================

# ==============================================================================
# 1. PUBLIC / BROWSER-SAFE VARIABLES (NEXT_PUBLIC_*)
# Bundled to the browser by Next.js compiler. Must NEVER contain secrets.
# ==============================================================================

# Application Base URLs (Must be HTTPS in production; localhost prohibited in prod)
NEXT_PUBLIC_APP_URL=https://taxaihelp.com
NEXT_PUBLIC_SITE_URL=https://taxaihelp.com

# Supabase (Client-safe public connection endpoints)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key # Optional alias for publishable key

# Stripe Client Key (Public key for Stripe Elements / browser checkout)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_for_development


# ==============================================================================
# 2. SERVER-ONLY SECRETS (NEVER EXPOSE WITH NEXT_PUBLIC_ PREFIX)
# Accessible strictly within Server Components, Route Handlers, and backend logic.
# ==============================================================================

# Supabase Backend Service Role (Bypasses RLS for administrative operations)
SUPABASE_SERVICE_ROLE_KEY=your-server-side-supabase-service-role-key-placeholder

# Google Gemini AI (Required in production when ai.assistant_enabled is true)
GEMINI_API_KEY=your-server-side-gemini-api-key-placeholder

# Stripe Payments Server Keys (Required in production when billing.enabled is true)
STRIPE_SECRET_KEY=sk_test_placeholder_key_for_development
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_signing_secret

# Scheduled Maintenance & Vercel Cron Authentication Secret
CRON_SECRET=your-server-side-cron-secret-token-placeholder


# ==============================================================================
# 3. RUNTIME ENVIRONMENT & AUTHORIZATION (SERVER-ONLY)
# ==============================================================================

# Standard Node Runtime Mode (development | staging | production | test)
NODE_ENV=development

# Explicit Application Environment (Overrides NODE_ENV for staging clusters)
APP_ENV=development

# Administrative Authorization Bootstrapping (Comma-delimited verified emails / UUIDs)
ADMIN_EMAILS=admin@taxaihelp.com
ADMIN_USER_IDS=00000000-0000-0000-0000-000000000001


# ==============================================================================
# 4. STRIPE SUBSCRIPTION PRICE IDS (SERVER-ONLY)
# Configured in Stripe Dashboard under Products > Pricing
# ==============================================================================

STRIPE_PRICE_ID_PREMIUM_MONTHLY=price_test_premium_monthly
STRIPE_PRICE_ID_PREMIUM_ANNUAL=price_test_premium_annual
STRIPE_PRICE_ID_PROFESSIONAL=price_test_professional_monthly
STRIPE_PRICE_ID_PROFESSIONAL_ANNUAL=price_test_professional_annual


# ==============================================================================
# 5. OPTIONAL & FEATURE-DEPENDENT CONFIGURATION (SERVER-ONLY)
# ==============================================================================

# Transactional Email Delivery (Options: null | console | resend | smtp)
# When 'null', email sending is skipped and in-app notification center remains active.
EMAIL_PROVIDER=null
EMAIL_API_KEY=your-server-side-email-api-key-placeholder
EMAIL_FROM=TaxAIHelp <notifications@taxaihelp.com>
EMAIL_REPLY_TO=support@taxaihelp.com
ADMIN_NOTIFICATION_EMAIL=admin@taxaihelp.com

# Database Backup Provider (Options: null | supabase)
BACKUP_PROVIDER=null
